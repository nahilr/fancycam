<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeColor="#282828"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLogBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#282828"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="#C0C0C0"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                tools:text="PHOTO" />

            <TextView
                android:id="@+id/tvLogTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="#777777"
                android:textSize="11sp"
                tools:text="2026-10-15 03:20:00" />

            <ImageView
                android:id="@+id/ivLogStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_check_circle"
                app:tint="#888888" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            tools:text="Photo captured" />

        <TextView
            android:id="@+id/tvLogDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#999999"
            android:textSize="12sp"
            tools:text="/storage/emulated/0/DCIM/Camera/IMG_20261015_032000.jpg" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
