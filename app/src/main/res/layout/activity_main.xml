<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Camera Preview Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <!-- Shutter Flash View for visual feedback -->
    <View
        android:id="@+id/shutterFlashView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar Overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#B3121212"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:fontFamily="sans-serif-medium"
            android:text="FancyCam"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Flash"
            android:padding="10dp"
            android:src="@drawable/ic_flash_auto"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Status Guidance Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#CC1A1A1A"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:strokeColor="#282828"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Initializing camera..."
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="#B30A0C10"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Captured Photo Thumbnail Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/photoThumbnailCard"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="Last captured photo preview"
            app:cardBackgroundColor="#262F40"
            app:cardCornerRadius="27dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/photoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Photo thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Shutter Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/captureButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Take Photo"
            app:backgroundTint="#FFFFFF"
            app:fabCustomSize="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxImageSize="36dp"
            app:srcCompat="@android:drawable/ic_menu_camera"
            app:tint="#000000" />

        <!-- Camera Switch (Front/Back) Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/switchCameraButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:clickable="true"
            android:contentDescription="Switch Camera"
            android:focusable="true"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="27dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#80FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/switchCameraIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Switch Camera"
                android:padding="13dp"
                android:src="@drawable/ic_camera_switch"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>