<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <!-- Top App Bar (Clean & Monotone) -->
    <LinearLayout
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#181818"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- Live Health Pill in Toolbar -->
        <LinearLayout
            android:id="@+id/healthToolbarPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#242424"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/viewHealthDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ic_check_circle"
                android:backgroundTint="#888888" />

            <TextView
                android:id="@+id/tvHealthToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Checking..."
                android:textColor="#B0B0B0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Server Configuration Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#2C2C2C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Server Connection"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <!-- Active Health Status Banner -->
                    <LinearLayout
                        android:id="@+id/layoutHealthStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#222222"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/ivHealthStatusIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Health status"
                            android:src="@drawable/ic_sync"
                            app:tint="#A0A0A0" />

                        <TextView
                            android:id="@+id/tvActiveHealthStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Checking server health..."
                            android:textColor="#A0A0A0"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- IP / Host Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Server IP / Host"
                        android:textColorHint="#707070"
                        app:boxBackgroundColor="#141414"
                        app:boxStrokeColor="#666666"
                        app:hintTextColor="#CCCCCC">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:inputType="textUri"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Port Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Port"
                        android:textColorHint="#707070"
                        app:boxBackgroundColor="#141414"
                        app:boxStrokeColor="#666666"
                        app:hintTextColor="#CCCCCC">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:inputType="number"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Save & Check Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveConfig"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#E0E0E0"
                            android:fontFamily="sans-serif-medium"
                            android:text="Save"
                            android:textAllCaps="false"
                            android:textColor="#121212"
                            android:textSize="14sp"
                            app:cornerRadius="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCheckHealth"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Check"
                            android:textAllCaps="false"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_sync"
                            app:iconSize="16dp"
                            app:iconTint="#E0E0E0"
                            app:strokeColor="#444444"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Activities Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#2C2C2C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Recent Activity"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearActivities"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Clear"
                            android:textAllCaps="false"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_delete"
                            app:iconSize="14dp"
                            app:iconTint="#888888" />
                    </RelativeLayout>

                    <!-- Activities Container -->
                    <LinearLayout
                        android:id="@+id/layoutActivitiesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvNoActivities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="center"
                        android:text="No recent activity"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
